{
  "name": "azure-agent-manager",
  "version": "1.1.0",
  "description": "Azure Agent Manager — local & distributed AI agents with Ollama, projects, pairing and tokens",
  "main": "src/main/main.js",
  "author": "Azure",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.azure.agentmanager",
    "productName": "Azure Agent Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/app.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/app.png"
    }
  }
}
