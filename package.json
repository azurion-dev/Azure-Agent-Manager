{
  "name": "azure-agent-manager",
  "version": "1.0.0",
  "description": "Azure Agent Manager — local & distributed AI agents with Ollama, projects, pairing and tokens",
  "main": "src/main/main.js",
  "author": "Azurion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/azurion-dev/Azure-Agent-Manager.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.azurion.agentmanager",
    "productName": "Azure Agent Manager",
    "copyright": "Copyright © Azurion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "azurion-dev",
        "repo": "Azure-Agent-Manager"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/app.ico",
      "artifactName": "AAM_WIN_amd64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "installerHeaderIcon": "assets/app.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Azure Agent Manager"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/app.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/app.png"
    }
  }
}
